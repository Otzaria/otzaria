  "scope": "Independent native PDFium source-opening and rasterization probe. Does not execute the application preview controller. Process memory includes Python and PDFium.",
  "method": {
    "processes": "30 fresh subprocesses. Three repeats per fixture/source/metadata configuration. Source order alternates between repeats. Initial all-metadata and later selected-metadata batches are separate, not paired in time.",
    "file_path": "FPDF_LoadDocument",
    "bytes_path": "Read complete file, retain bytes, copy to an owned C buffer, FPDF_LoadMemDocument64; both buffers live while the document is open",
    "page_metadata": "all: FPDF_GetPageSizeByIndex for every page. selected: first page plus selected range (3 distinct pages here), approximating progressive source opening at the native boundary. Neither executes the Dart controller.",
    "first_page": "Completion of first FPDF_RenderPageBitmap, including source read/copy, open and configured metadata work; excludes pixel hashing. It is not first UI paint.",
    "memory": "RSS and Private_Clean+Private_Dirty from /proc/self/smaps_rollup sampled every 10 ms and between phases. OS lifetime peak RSS recorded separately.",
    "pixel_parity": "SHA-256 over raw native bitmap bytes including stride (BGRx with alpha disabled). All recorded source/metadata configurations for each fixture have identical dimensions and hashes.",
    "os_file_cache": "Not controlled; no claim of cold-cache measurements"
  },
