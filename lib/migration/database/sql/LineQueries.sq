-- Queries for lines

selectByBookId:
SELECT * FROM line WHERE bookId = ? ORDER BY lineIndex;

selectByBookIdRange:
SELECT * FROM line
WHERE bookId = ?
AND lineIndex >= ?
AND lineIndex <= ?
ORDER BY lineIndex;

-- מסלול האינדוקס: תוכן בלבד, בסדר השורות. SELECT * היה גורר בניית Map
-- ואובייקט Line מלא לכל שורה (מיליוני שורות בספרייה) רק כדי לזרוק הכול
-- חוץ מ-content.
selectContentByBookId:
SELECT content FROM line WHERE bookId = ? ORDER BY lineIndex;

selectByBookIdAndIndex:
SELECT * FROM line WHERE bookId = ? AND lineIndex = ?;

selectByHeRef:
SELECT * FROM line WHERE heRef = ? LIMIT 1;

-- סכמה 6 (DbCapabilities.hasSplitLineContent): התוכן ב-line_content לפי אותו id.
-- LEFT JOIN — שורה בלי תוכן תוצג ריקה ולא תיעלם מהטווח.
selectByBookIdSplit:
SELECT l.*, COALESCE(lc.content, '') AS content
FROM line l LEFT JOIN line_content lc ON lc.id = l.id
WHERE l.bookId = ? ORDER BY l.lineIndex;

selectByBookIdRangeSplit:
SELECT l.*, COALESCE(lc.content, '') AS content
FROM line l LEFT JOIN line_content lc ON lc.id = l.id
WHERE l.bookId = ?
AND l.lineIndex >= ?
AND l.lineIndex <= ?
ORDER BY l.lineIndex;

selectContentByBookIdSplit:
SELECT lc.content
FROM line l LEFT JOIN line_content lc ON lc.id = l.id
WHERE l.bookId = ? ORDER BY l.lineIndex;

selectByBookIdAndIndexSplit:
SELECT l.*, COALESCE(lc.content, '') AS content
FROM line l LEFT JOIN line_content lc ON lc.id = l.id
WHERE l.bookId = ? AND l.lineIndex = ?;

selectByHeRefSplit:
SELECT l.*, COALESCE(lc.content, '') AS content
FROM line l LEFT JOIN line_content lc ON lc.id = l.id
WHERE l.heRef = ? LIMIT 1;

-- כל ה-heRef-ים של ספר, רזה (בלי content) — לרזולוציית הפניה לרמת שורה.
selectRefsByBookId:
SELECT lineIndex, heRef FROM line
WHERE bookId = ? AND heRef IS NOT NULL AND heRef != ''
ORDER BY lineIndex;

insert:
INSERT INTO line (bookId, lineIndex, content, heRef, tocEntryId)
VALUES (?, ?, ?, ?, ?);

updateTocEntryId:
UPDATE line SET tocEntryId = ? WHERE id = ?;

updateHeRef:
UPDATE line SET heRef = ? WHERE id = ?;

delete:
DELETE FROM line WHERE id = ?;

deleteByBookId:
DELETE FROM line WHERE bookId = ?;

countByBookId:
SELECT COUNT(*) FROM line WHERE bookId = ?;
