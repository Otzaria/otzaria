-- Queries for lines

selectById:
SELECT * FROM line WHERE id = ?;

selectByBookId:
SELECT * FROM line WHERE bookId = ? ORDER BY lineIndex;

selectByBookIdRange:
SELECT * FROM line
WHERE bookId = ?
AND lineIndex >= ?
AND lineIndex <= ?
ORDER BY lineIndex;

-- מסלול האינדוקס: תוכן בלבד, בסדר השורות. SELECT * היה גורר בניית Map
-- ואובייקט Line מלא לכל שורה (מיליוני שורות בספרייה) רק כדי לזרוק הכול
-- חוץ מ-content.
selectContentByBookId:
SELECT content FROM line WHERE bookId = ? ORDER BY lineIndex;

-- כמו selectContentByBookId אך כבייטים גולמיים (UTF-8 כפי שמאוחסן):
-- מסלול האינדוקס מעביר אותם למנוע כמות-שהם ונמנע מפענוח ל-String
-- וקידוד חוזר על גשר ה-FFI.
selectContentBlobByBookId:
SELECT CAST(content AS BLOB) FROM line WHERE bookId = ? ORDER BY lineIndex;

selectByBookIdAndIndex:
SELECT * FROM line WHERE bookId = ? AND lineIndex = ?;

selectByHeRef:
SELECT * FROM line WHERE heRef = ? LIMIT 1;

selectByHeRefLike:
SELECT * FROM line WHERE heRef LIKE ? ORDER BY bookId, lineIndex LIMIT ?;

insert:
INSERT INTO line (bookId, lineIndex, content, heRef, tocEntryId)
VALUES (?, ?, ?, ?, ?);

updateTocEntryId:
UPDATE line SET tocEntryId = ? WHERE id = ?;

updateHeRef:
UPDATE line SET heRef = ? WHERE id = ?;

delete:
DELETE FROM line WHERE id = ?;

deleteByBookId:
DELETE FROM line WHERE bookId = ?;

countByBookId:
SELECT COUNT(*) FROM line WHERE bookId = ?;

lastInsertRowId:
SELECT last_insert_rowid();
