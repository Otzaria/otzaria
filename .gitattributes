# Generated Dart files - keep LF to avoid spurious diffs on Windows
*.g.dart text eol=lf

# Shell scripts must stay LF - bash on Linux/macOS breaks on CRLF
*.sh text eol=lf

# Generated plugin SDK spec - the generator emits LF and the freshness test
# compares its output to the file on disk byte-for-byte. With autocrlf the
# working copy got CRLF, so the test reported "stale" for every Windows
# developer (and would do the same on a windows CI runner) while git itself
# showed no diff at all.
docs/plugin-sdk/spec.json text eol=lf

# pubspec.lock is generated by pub; collapse it in pull request diffs.
pubspec.lock linguist-generated=true

# model.json is compared byte-for-byte with the published release copy and
# handed to the engine as-is; autocrlf must not rewrite it.
assets/semantic/** -text

# Assemble scripts are release assets that several jobs upload; every checkout must
# hold the same bytes, Windows included.
tool/release/assemble_split_asset.ps1 text eol=lf

# ui_lint baseline - the CLI writes LF and ui_lint_test compares it byte-for-byte.
tool/ui_lint/baseline.json text eol=lf
