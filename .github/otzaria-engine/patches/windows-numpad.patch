+TEST(KeyboardKeyEmbedderHandlerTest, NumpadOperatorsKeepTheirLogicalKeys) {
+  const struct {
+    int virtual_key;
+    int scan;
+    bool extended;
+    uint64_t physical;
+    uint64_t logical;
+  } keys[] = {
+      {VK_MULTIPLY, 0x37, false, kPhysicalNumpadMultiply, kLogicalNumpadMultiply},
+      {VK_ADD, 0x4e, false, kPhysicalNumpadAdd, kLogicalNumpadAdd},
+      {VK_SUBTRACT, 0x4a, false, kPhysicalNumpadSubtract, kLogicalNumpadSubtract},
+      {VK_DIVIDE, 0x35, true, kPhysicalNumpadDivide, kLogicalNumpadDivide},
+      {VK_RETURN, 0x1c, true, kPhysicalNumpadEnter, kLogicalEnter},
+  };
+  for (const auto& key : keys) {
+    NumpadKeyRecorder recorder;
+    recorder.Send(key.virtual_key, key.scan, WM_KEYDOWN, key.extended);
+    recorder.Send(key.virtual_key, key.scan, WM_KEYUP, key.extended, true);
+    const auto events = recorder.ForPhysical(key.physical);
+    ASSERT_EQ(events.size(), 2u);
+    EXPECT_EQ(events[0].logical, key.logical);
+    EXPECT_EQ(events[1].logical, key.logical);
+    EXPECT_TRUE(recorder.handler->GetPressedState().empty());
+  }
+}
