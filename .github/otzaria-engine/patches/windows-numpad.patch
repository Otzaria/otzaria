+TEST(KeyboardKeyEmbedderHandlerTest, NumpadRecoversAfterMissedRelease) {
+  NumpadKeyRecorder recorder;
+  recorder.Send(VK_UP, 0x48, WM_KEYDOWN);
+  recorder.state.Set(VK_NUMLOCK, false, true);
+  recorder.Send(VK_NUMPAD8, 0x48, WM_KEYDOWN, false, false, '8');
+  recorder.Send(VK_NUMPAD8, 0x48, WM_KEYUP, false, true);
+  const auto events = recorder.ForPhysical(kPhysicalNumpad8);
+  ASSERT_EQ(events.size(), 4u);
+  EXPECT_EQ(events[0].logical, kLogicalArrowUp);
+  EXPECT_EQ(events[1].type, kFlutterKeyEventTypeUp);
+  EXPECT_EQ(events[1].logical, kLogicalArrowUp);
+  EXPECT_TRUE(events[1].synthesized);
+  EXPECT_EQ(events[2].type, kFlutterKeyEventTypeDown);
+  EXPECT_EQ(events[2].logical, kLogicalNumpad8);
+  EXPECT_EQ(events[2].character, "8");
+  EXPECT_EQ(events[3].type, kFlutterKeyEventTypeUp);
+  EXPECT_EQ(events[3].logical, kLogicalNumpad8);
+  EXPECT_EQ(recorder.handler->GetPressedState().count(kPhysicalNumpad8), 0u);
+}
