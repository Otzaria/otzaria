+namespace {
+
+struct RecordedNumpadEvent {
+  FlutterKeyEventType type;
+  uint64_t physical;
+  uint64_t logical;
+  bool synthesized;
+  std::string character;
+};
+
+class NumpadKeyRecorder {
+ public:
+  explicit NumpadKeyRecorder(bool num_lock = false, bool shift = false) {
+    state.Set(VK_NUMLOCK, false, num_lock);
+    state.Set(VK_SHIFT, shift);
+    state.Set(VK_LSHIFT, shift);
+    handler = std::make_unique<KeyboardKeyEmbedderHandler>(
+        [this](const FlutterKeyEvent& event, FlutterKeyEventCallback callback,
+               void* user_data) {
+          events.push_back({event.type, event.physical, event.logical,
+                            event.synthesized,
+                            event.character == nullptr ? "" : event.character});
+          if (callback != nullptr) {
+            callback(false, user_data);
+          }
+        },
+        state.Getter(), DefaultMapVkToScan);
+  }
+
+  void Send(int key, int scan, int action, bool extended = false,
+            bool was_down = false, char32_t character = 0) {
+    handler->KeyboardHook(key, scan, action, character, extended, was_down,
+                          [](bool) {});
+  }
+
+  std::vector<RecordedNumpadEvent> ForPhysical(uint64_t physical) const {
+    std::vector<RecordedNumpadEvent> result;
+    for (const auto& event : events) {
+      if (event.physical == physical) {
+        result.push_back(event);
+      }
+    }
+    return result;
+  }
+
+  TestKeystate state;
+  std::vector<RecordedNumpadEvent> events;
+  std::unique_ptr<KeyboardKeyEmbedderHandler> handler;
+};
+
+}  // namespace
+
+TEST(KeyboardKeyEmbedderHandlerTest, NumpadNavigationUsesNativeVirtualKeys) {
+  const struct {
+    int virtual_key;
+    int scan;
+    uint64_t physical;
+    uint64_t logical;
+  } keys[] = {
+      {VK_INSERT, 0x52, kPhysicalNumpad0, kLogicalInsert},
+      {VK_END, 0x4f, kPhysicalNumpad1, kLogicalEnd},
+      {VK_DOWN, 0x50, kPhysicalNumpad2, kLogicalArrowDown},
+      {VK_NEXT, 0x51, kPhysicalNumpad3, kLogicalPageDown},
+      {VK_LEFT, 0x4b, kPhysicalNumpad4, kLogicalArrowLeft},
+      {VK_CLEAR, 0x4c, kPhysicalNumpad5, kLogicalClear},
+      {VK_RIGHT, 0x4d, kPhysicalNumpad6, kLogicalArrowRight},
+      {VK_HOME, 0x47, kPhysicalNumpad7, kLogicalHome},
+      {VK_UP, 0x48, kPhysicalNumpad8, kLogicalArrowUp},
+      {VK_PRIOR, 0x49, kPhysicalNumpad9, kLogicalPageUp},
+      {VK_DELETE, 0x53, kPhysicalNumpadDecimal, kLogicalDelete},
+  };
+  for (const auto& key : keys) {
+    for (bool num_lock : {false, true}) {
+      for (bool shift : {false, true}) {
+        for (bool system : {false, true}) {
+          SCOPED_TRACE(key.virtual_key);
+          SCOPED_TRACE(num_lock);
+          SCOPED_TRACE(shift);
+          SCOPED_TRACE(system);
+          NumpadKeyRecorder recorder(num_lock, shift);
+          const int down = system ? WM_SYSKEYDOWN : WM_KEYDOWN;
+          const int up = system ? WM_SYSKEYUP : WM_KEYUP;
+          recorder.Send(key.virtual_key, key.scan, down);
+          EXPECT_EQ(recorder.handler->GetPressedState().at(key.physical),
+                    key.logical);
+          recorder.Send(key.virtual_key, key.scan, down, false, true);
+          recorder.Send(key.virtual_key, key.scan, up, false, true);
+          const auto events = recorder.ForPhysical(key.physical);
+          ASSERT_EQ(events.size(), 3u);
+          EXPECT_EQ(events[0].type, kFlutterKeyEventTypeDown);
+          EXPECT_EQ(events[1].type, kFlutterKeyEventTypeRepeat);
+          EXPECT_EQ(events[2].type, kFlutterKeyEventTypeUp);
+          for (const auto& event : events) {
+            EXPECT_EQ(event.logical, key.logical);
+            EXPECT_FALSE(event.synthesized);
+            EXPECT_TRUE(event.character.empty());
+          }
+          EXPECT_EQ(recorder.handler->GetPressedState().count(key.physical), 0u);
+        }
+      }
+    }
+  }
+}
