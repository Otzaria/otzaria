+TEST(KeyboardKeyEmbedderHandlerTest, NumpadDigitsWithNumLockOnAtStartup) {
+  const struct {
+    int virtual_key;
+    int scan;
+    uint64_t physical;
+    uint64_t logical;
+  } keys[] = {
+      {VK_NUMPAD0, 0x52, kPhysicalNumpad0, kLogicalNumpad0},
+      {VK_NUMPAD1, 0x4f, kPhysicalNumpad1, kLogicalNumpad1},
+      {VK_NUMPAD2, 0x50, kPhysicalNumpad2, kLogicalNumpad2},
+      {VK_NUMPAD3, 0x51, kPhysicalNumpad3, kLogicalNumpad3},
+      {VK_NUMPAD4, 0x4b, kPhysicalNumpad4, kLogicalNumpad4},
+      {VK_NUMPAD5, 0x4c, kPhysicalNumpad5, kLogicalNumpad5},
+      {VK_NUMPAD6, 0x4d, kPhysicalNumpad6, kLogicalNumpad6},
+      {VK_NUMPAD7, 0x47, kPhysicalNumpad7, kLogicalNumpad7},
+      {VK_NUMPAD8, 0x48, kPhysicalNumpad8, kLogicalNumpad8},
+      {VK_NUMPAD9, 0x49, kPhysicalNumpad9, kLogicalNumpad9},
+      {VK_DECIMAL, 0x53, kPhysicalNumpadDecimal, kLogicalNumpadDecimal},
+  };
+  for (const auto& key : keys) {
+    for (bool control : {false, true}) {
+      SCOPED_TRACE(key.virtual_key);
+      SCOPED_TRACE(control);
+      NumpadKeyRecorder recorder(true);
+      recorder.state.Set(VK_CONTROL, control);
+      recorder.state.Set(VK_LCONTROL, control);
+      char32_t character = 0;
+      if (!control) {
+        character = key.virtual_key == VK_DECIMAL
+                        ? '.'
+                        : static_cast<char32_t>('0' + key.virtual_key - VK_NUMPAD0);
+      }
+      recorder.Send(key.virtual_key, key.scan, WM_KEYDOWN, false, false,
+                    character);
+      recorder.Send(key.virtual_key, key.scan, WM_KEYUP, false, true);
+      const auto events = recorder.ForPhysical(key.physical);
+      ASSERT_EQ(events.size(), 2u);
+      EXPECT_EQ(events[0].logical, key.logical);
+      EXPECT_EQ(events[1].logical, key.logical);
+      EXPECT_EQ(events[0].character,
+                control ? "" : std::string(1, static_cast<char>(character)));
+      EXPECT_EQ(recorder.handler->GetPressedState().count(key.physical), 0u);
+    }
+  }
+}
