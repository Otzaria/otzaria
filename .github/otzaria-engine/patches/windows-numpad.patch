+TEST(KeyboardKeyEmbedderHandlerTest, NumpadNavigationKeepsIdentityAcrossNumLock) {
+  NumpadKeyRecorder recorder;
+  recorder.Send(VK_UP, 0x48, WM_KEYDOWN);
+  recorder.state.Set(VK_NUMLOCK, true, true);
+  recorder.Send(VK_NUMLOCK, 0x45, WM_KEYDOWN, true);
+  recorder.state.Set(VK_NUMLOCK, false, true);
+  recorder.Send(VK_NUMLOCK, 0x45, WM_KEYUP, true, true);
+  recorder.Send(VK_NUMPAD8, 0x48, WM_KEYDOWN, false, true, '8');
+  recorder.Send(VK_NUMPAD8, 0x48, WM_KEYUP, false, true);
+  const auto events = recorder.ForPhysical(kPhysicalNumpad8);
+  ASSERT_EQ(events.size(), 3u);
+  EXPECT_EQ(events[1].type, kFlutterKeyEventTypeRepeat);
+  EXPECT_EQ(events[2].type, kFlutterKeyEventTypeUp);
+  for (const auto& event : events) {
+    EXPECT_EQ(event.logical, kLogicalArrowUp);
+  }
+  EXPECT_TRUE(recorder.handler->GetPressedState().empty());
+}
+
+TEST(KeyboardKeyEmbedderHandlerTest, NumpadAndDedicatedArrowsStayDistinct) {
+  NumpadKeyRecorder recorder;
+  recorder.Send(VK_UP, 0x48, WM_KEYDOWN);
+  recorder.Send(VK_UP, 0x48, WM_KEYDOWN, true);
+  EXPECT_EQ(recorder.handler->GetPressedState().size(), 2u);
+  EXPECT_EQ(recorder.handler->GetPressedState().at(kPhysicalNumpad8),
+            kLogicalArrowUp);
+  EXPECT_EQ(recorder.handler->GetPressedState().at(kPhysicalArrowUp),
+            kLogicalArrowUp);
+  recorder.Send(VK_UP, 0x48, WM_KEYUP, false, true);
+  EXPECT_EQ(recorder.handler->GetPressedState().size(), 1u);
+  EXPECT_EQ(recorder.handler->GetPressedState().at(kPhysicalArrowUp),
+            kLogicalArrowUp);
+  recorder.Send(VK_UP, 0x48, WM_KEYUP, true, true);
+  EXPECT_TRUE(recorder.handler->GetPressedState().empty());
+}
